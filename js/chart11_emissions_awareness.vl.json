{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "width": 480,
  "height": 260,
  "padding": 10,
  "title": {
    "text": ["Do Australian Farmers Know Their", "Greenhouse Gas Emissions?"],
    "subtitle": [
      "Emissions awareness and management plans among",
      "broadacre (mainly crop and livestock) and dairy farms, 2023–24"
    ],
    "anchor": "middle",
    "font": "Lato",
    "fontSize": 28,
    "fontWeight": 900,
    "subtitleFont": "Lato",
    "subtitleFontSize": 16,
    "subtitleFontWeight": 400,
    "subtitlePadding": 12,
    "offset": 30
  },
  "data": {
    "url": "data/chart11_emissions_awareness_2023_24.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percentage": "number",
        "order": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "display_indicator",
      "type": "nominal",
      "sort": {
        "field": "order",
        "order": "ascending"
      },
      "axis": {
        "title": "What farmers reported",
        "labelLimit": 290,
        "labelFontSize": 14,
        "labelPadding": 12,
        "ticks": false,
        "domain": false,
        "titleAngle": 0,
        "titleAlign": "left",
        "titleAnchor": "start",
        "titleY": -24,
        "titleX": -285,
        "titleFontSize": 15
      }
    },
    "x": {
      "field": "percentage",
      "type": "quantitative",
      "scale": {
        "domain": [0, 100],
        "nice": false
      },
      "axis": {
        "title": "Farms (%)",
        "values": [0, 20, 40, 60, 80, 100],
        "labelExpr": "datum.value + '%'",
        "titleFontSize": 16,
        "titlePadding": 16
      }
    },
    "color": {
      "value": "#06402B"
    },
    "tooltip": [
      {
        "field": "tooltip_indicator",
        "title": "Indicator"
      },
      {
        "field": "tooltip_percentage",
        "title": "Percentage"
      },
      {
        "field": "timeframe",
        "title": "Timeframe"
      },
      {
        "field": "survey_year",
        "title": "Survey year"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 200,
        "opacity": 1
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 16,
        "fontWeight": 700
      },
      "transform": [
        {
          "calculate": "datum.percentage + '%'",
          "as": "percent_label"
        }
      ],
      "encoding": {
        "text": {
          "field": "percent_label"
        }
      }
    }
  ],
  "config": {
    "font": "Lato",
    "axis": {
      "labelFont": "Lato",
      "titleFont": "Lato",
      "labelFontSize": 13,
      "gridColor": "#E5EDE3",
      "domainColor": "#AAB8AD"
    },
    "axisY": {
      "grid": false
    },
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "calculate": "datum.order == 3 ? 'Planned a new NRM/emissions activity' : datum.indicator",
      "as": "display_indicator"
    },
    {
      "calculate": "datum.order == 3 ? 'Planned new natural-resource or net-emissions management activity' : datum.description",
      "as": "tooltip_indicator"
    },
    {
      "calculate": "datum.percentage + '%'",
      "as": "tooltip_percentage"
    },
    {
      "calculate": "datum.order == 3 ? 'Within the next two years' : 'At the time of the survey'",
      "as": "timeframe"
    }
  ]
}
