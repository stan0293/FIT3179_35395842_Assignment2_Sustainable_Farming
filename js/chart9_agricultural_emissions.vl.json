{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Have Australia’s Agricultural Emissions Changed?",
    "subtitle": "Agriculture inventory sector, 1989–90 to 2023–24",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 18
  },
  "width": "container",
  "height": 360,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/agricultural_emissions_trend.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year_end": "number",
        "emissions_mtco2e": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "year_end",
      "type": "quantitative",
      "title": "Financial year ending",
      "scale": {
        "domain": [1990, 2024],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [1990, 1995, 2000, 2005, 2010, 2015, 2020, 2024],
        "format": "d",
        "labelOverlap": true,
        "grid": false
      }
    },
    "y": {
      "field": "emissions_mtco2e",
      "type": "quantitative",
      "title": "Emissions (Mt CO₂-e)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "values": [0, 20, 40, 60, 80, 100]
      }
    },
    "tooltip": [
      {
        "field": "financial_year",
        "type": "nominal",
        "title": "Financial year"
      },
      {
        "field": "emissions_mtco2e",
        "type": "quantitative",
        "title": "Agricultural emissions (Mt CO₂-e)",
        "format": ".2f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#0072B2",
        "strokeWidth": 3
      },
      "encoding": {
        "order": {
          "field": "year_end",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#0072B2",
        "size": 45
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_end === 1990 || datum.year_end === 2024"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#005580"
      },
      "encoding": {
        "text": {
          "field": "emissions_mtco2e",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#eeeeee"
    },
    "title": {
      "color": "black",
      "subtitleColor": "black"
    }
  }
}