{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "title": {
    "text": "Where Are Australian Farms Adopting Water-Management Practices?",
    "subtitle": "Estimated percentage of farms adopting two water-management practices by state, 2021",
    "anchor": "middle",
    "font": "Lato",
    "fontSize": 28,
    "subtitleFont": "Lato",
    "subtitleFontSize": 16,
    "color": "#000000",
    "subtitleColor": "#000000",
    "offset": 32,
    "fontWeight": 900,
    "subtitlePadding": 10,
    "align": "center",
    "frame": "bounds",
    "subtitleFontWeight": 400,
    "subtitleLineHeight": 20,
    "lineHeight": 34
  },
  "hconcat": [
    {
      "width": 400,
      "height": 380,
      "title": {
        "text": "Using Water-Efficient Crops and Pastures",
        "anchor": "middle",
        "font": "Lato",
        "fontSize": 17,
        "color": "#153C2C",
        "offset": 18,
        "align": "center"
      },
      "data": {
        "url": "https://raw.githubusercontent.com/tonywr71/GeoJson-Data/master/australian-states.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/chart05_water_practices_state_2021.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "water_efficient_varieties_pct": "string",
                  "increased_water_storage_pct": "string",
                  "farms_surveyed": "number",
                  "estimated_farm_population": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "water_efficient_varieties_pct",
              "increased_water_storage_pct",
              "farms_surveyed",
              "estimated_farm_population",
              "survey_year"
            ]
          }
        },
        {
          "calculate": "!isValid(datum.water_efficient_varieties_pct) || trim(toString(datum.water_efficient_varieties_pct)) === '' ? null : toNumber(datum.water_efficient_varieties_pct)",
          "as": "adoption_pct"
        },
        {
          "calculate": "!isValid(datum.adoption_pct) ? null : datum.adoption_pct < 20 ? '0–<20%' : datum.adoption_pct < 40 ? '20–<40%' : datum.adoption_pct < 60 ? '40–<60%' : datum.adoption_pct < 80 ? '60–<80%' : '80–100%'",
          "as": "adoption_band"
        },
        {
          "calculate": "isValid(datum.adoption_pct) ? format(datum.adoption_pct, '.0f') + '%' : 'No estimate'",
          "as": "adoption_label"
        }
      ],
      "projection": {
        "type": "conicEqualArea",
        "parallels": [-18, -36],
        "rotate": [-134, 0, 0]
      },
      "layer": [
        {
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 1.2
          },
          "encoding": {
            "color": {
              "field": "adoption_band",
              "type": "ordinal",
              "title": "Farms adopting (%)",
              "scale": {
                "domain": ["0–<20%", "20–<40%", "40–<60%", "60–<80%", "80–100%"],
                "range": ["#f2e5f5", "#d3b6e2", "#ae80c8", "#8050a7", "#542078"]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "symbolType": "square",
                "symbolSize": 196,
                "symbolStrokeColor": "#ffffff",
                "labelFont": "Lato",
                "labelFontSize": 15,
                "titleFont": "Lato",
                "titleFontSize": 16,
                "titleLimit": 180,
                "labelOffset": 9,
                "offset": 40,
                "rowPadding": 8,
                "columns": 5,
                "columnPadding": 16
              }
            },
            "tooltip": [
              {
                "field": "properties.STATE_NAME",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "survey_year",
                "type": "nominal",
                "title": "Survey year"
              },
              {
                "field": "adoption_label",
                "type": "nominal",
                "title": "Adoption rate"
              },
              {
                "field": "farms_surveyed",
                "type": "quantitative",
                "title": "State survey sample—all practices",
                "format": ",.0f"
              },
              {
                "field": "estimated_farm_population",
                "type": "quantitative",
                "title": "Estimated eligible farm population—state",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "joinaggregate": [
                {
                  "op": "max",
                  "field": "adoption_pct",
                  "as": "highest_adoption_pct"
                }
              ]
            },
            {
              "filter": "isValid(datum.adoption_pct) && datum.adoption_pct === datum.highest_adoption_pct"
            },
            {
              "filter": "datum.properties.STATE_NAME !== 'Australian Capital Territory'"
            },
            {
              "calculate": "datum.geometry.type === 'Polygon' ? {type: 'Polygon', coordinates: [datum.geometry.coordinates[0]]} : datum.geometry",
              "as": "outer_boundary"
            }
          ],
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#000000",
            "strokeWidth": 2.5
          },
          "encoding": {
            "shape": {
              "field": "outer_boundary",
              "type": "geojson"
            },
            "tooltip": [
              {
                "field": "properties.STATE_NAME",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "survey_year",
                "type": "nominal",
                "title": "Survey year"
              },
              {
                "field": "adoption_label",
                "type": "nominal",
                "title": "Adoption rate"
              },
              {
                "field": "farms_surveyed",
                "type": "quantitative",
                "title": "State survey sample—all practices",
                "format": ",.0f"
              },
              {
                "field": "estimated_farm_population",
                "type": "quantitative",
                "title": "Estimated eligible farm population—state",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "!isValid(datum.adoption_pct)"
            },
            {
              "calculate": "'No estimate'",
              "as": "publication_status"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#e5e7eb",
            "stroke": "#ffffff",
            "strokeWidth": 1.1
          },
          "encoding": {
            "tooltip": [
              {
                "field": "properties.STATE_NAME",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "survey_year",
                "type": "nominal",
                "title": "Survey year"
              },
              {
                "field": "publication_status",
                "type": "nominal",
                "title": "Adoption rate"
              }
            ]
          }
        },
