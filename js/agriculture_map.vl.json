{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Does Australia Farm?",
    "subtitle": "Agricultural land share by NRM region",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 16
  },
  "width": "container",
  "height": 550,
  "background": "#f7f8f2",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },
  "data": {
    "url": "data/Natural_Resource_Management_(NRM)_Regions_2023.topojson",
    "format": {
      "type": "topojson",
      "feature": "Natural_Resource_Management_(NRM)_Regions_2023"
    }
  },
  "transform": [
    {
      "lookup": "properties.NRM_REGION",
      "from": {
        "data": {
          "url": "data/agricultural_land_use_percentage_by_nrm.csv"
        },
        "key": "nrm_region_name",
        "fields": [
          "agricultural_land_area_ha",
          "total_mapped_region_area_ha",
          "agricultural_land_percentage"
        ]
      }
    },
    {
      "filter": "isValid(datum.agricultural_land_percentage)"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.6
  },
  "encoding": {
    "color": {
      "field": "agricultural_land_percentage",
      "type": "quantitative",
      "title": "Agricultural area (%)",
      "scale": {
        "type": "threshold",
        "domain": [20, 40, 60, 80],
        "range": [
          "#edf8e9",
          "#bae4b3",
          "#74c476",
          "#31a354",
          "#006d2c"
        ]
      },
      "legend": {
        "type": "symbol",
        "orient": "top-right",
        "direction": "vertical",
        "symbolType": "square",
        "symbolSize": 180,
        "titleFontSize": 12,
        "labelFontSize": 11,
        "offset": 8,
        "labelExpr": "datum.index === 0 ? 'Below 20%' : datum.index === 1 ? '20–<40%' : datum.index === 2 ? '40–<60%' : datum.index === 3 ? '60–<80%' : '80–100%'"
      }
    },
    "tooltip": [
      {
        "field": "properties.NRM_REGION",
        "type": "nominal",
        "title": "NRM region"
      },
      {
        "field": "agricultural_land_percentage",
        "type": "quantitative",
        "title": "Agricultural area (%)",
        "format": ".1f"
      },
      {
        "field": "agricultural_land_area_ha",
        "type": "quantitative",
        "title": "Agricultural area (ha)",
        "format": ",.0f"
      },
      {
        "field": "total_mapped_region_area_ha",
        "type": "quantitative",
        "title": "Total mapped area (ha)",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}