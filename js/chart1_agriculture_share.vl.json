{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "subtitleColor": "black"
    }
  },
  "title": {
    "text": "How Much of Australia’s Mapped Area Is Used for Agriculture?",
    "subtitle": "Agricultural versus Non-agricultural area across 57 Natural Resource Management (NRM) regions",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 16
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/national_agricultural_share.csv"
  },
  "mark": {
    "type": "arc",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "theta": {
      "field": "area_ha",
      "type": "quantitative",
      "stack": true
    },
    "color": {
      "field": "land_use_group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Agriculture", "Non-agriculture"],
        "range": ["#08306B", "#dedede"]
      },
      "legend": {
        "orient": "top-right",
        "direction": "vertical",
        "labelFontSize": 14,
        "symbolSize": 180,
        "rowPadding": 10,
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "land_use_group",
        "title": "Land use"
      },
      {
        "field": "share_percentage",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".1f"
      },
      {
        "field": "area_ha",
        "type": "quantitative",
        "title": "Area (ha)",
        "format": ",.0f"
      }
    ]
  }
}