{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Is Irrigation Water Used?",
    "subtitle": "Water applied to crops and pastures by state and territory, 2020–21",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 16
  },
  "width": "container",
  "height": 550,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },
  "layer": [
    {
      "data": {
        "url": "data/Natural_Resource_Management_(NRM)_Regions_2023.topojson",
        "format": {
          "type": "topojson",
          "feature": "Natural_Resource_Management_(NRM)_Regions_2023"
        }
      },
      "transform": [
        {
          "lookup": "properties.NRM_REGION",
          "from": {
            "data": {
              "url": "data/agricultural_land_use_percentage_by_nrm.csv"
            },
            "key": "nrm_region_name",
            "fields": [
              "agricultural_land_percentage"
            ]
          }
        },
        {
          "filter": "isValid(datum.agricultural_land_percentage)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/state_outlines.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#777777",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/irrigation_water_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.data_status === 'Published'"
        },
        {
          "calculate": "toNumber(datum.irrigation_water_applied_gl)",
          "as": "water_volume"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#2378B5",
        "opacity": 0.65,
        "stroke": "#15517C",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "water_volume",
          "type": "quantitative",
          "title": "Irrigation water applied (GL)",
          "scale": {
            "type": "linear",
            "domain": [0, 3000],
            "range": [0, 4000]
          },
          "legend": {
            "orient": "top-right",
            "values": [500, 1500, 2500],
            "labelFontSize": 12,
            "titleFontSize": 12,
            "format": ",.0f"
          }
        },
        "order": {
          "field": "water_volume",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "year",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "water_volume",
            "type": "quantitative",
            "title": "Irrigation water applied (GL)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/irrigation_water_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.state_code !== 'ACT'"
        },
        {
          "calculate": "datum.data_status === 'Not published' ? datum.state_code + ' (not published)' : datum.state_code",
          "as": "display_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -42,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "display_label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149.13,
            "latitude": -35.3,
            "longitude2": 155,
            "latitude2": -36.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#555555",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude2"
        },
        "latitude2": {
          "field": "latitude2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 155,
            "latitude": -36.5,
            "label": "ACT: not published"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 12,
        "color": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "subtitleColor": "black"
    }
  }
}