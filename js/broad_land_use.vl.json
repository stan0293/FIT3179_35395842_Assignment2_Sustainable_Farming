{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "subtitleColor": "black"
    }
  },
  "title": {
    "text": "How Is the Mapped Area Used?",
    "subtitle": "Broad land-use categories across the 57 NRM regions",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 16
  },
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/national_broad_land_use.csv"
  },
  "mark": {
    "type": "bar",
    "color": "#FFA500"
  },
  "encoding": {
    "y": {
      "field": "broad_land_use",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 180
      }
    },
    "x": {
      "field": "share_percentage",
      "type": "quantitative",
      "title": "Share of total mapped area (%)",
      "scale": {
        "domain": [
          0,
          55
        ]
      }
    },
    "tooltip": [
      {
        "field": "broad_land_use",
        "title": "Broad land use"
      },
      {
        "field": "share_percentage",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".2f"
      },
      {
        "field": "area_ha",
        "type": "quantitative",
        "title": "Area (ha)",
        "format": ",.0f"
      }
    ]
  }
}