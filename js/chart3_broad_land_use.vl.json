{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Is Agricultural Land Used?",
    "subtitle": "Broad agricultural uses across 57 NRM regions",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 16
  },
  "width": "container",
  "height": 250,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/national_broad_land_use.csv",
    "format": {
      "type": "csv",
      "parse": {
        "area_ha": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "broad_land_use",
        "oneOf": [
          "Livestock production",
          "Cropping",
          "Horticulture"
        ]
      }
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "area_ha",
          "as": "total_agricultural_area_ha"
        }
      ]
    },
    {
      "calculate": "datum.area_ha / datum.total_agricultural_area_ha * 100",
      "as": "agricultural_share_percentage"
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#FFA500"
  },
  "encoding": {
    "y": {
      "field": "broad_land_use",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelFontSize": 13,
        "labelLimit": 180
      }
    },
    "x": {
      "field": "agricultural_share_percentage",
      "type": "quantitative",
      "title": "Share of agricultural area (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "values": [0, 20, 40, 60, 80, 100],
        "labelFontSize": 12,
        "titleFontSize": 13
      }
    },
    "tooltip": [
      {
        "field": "broad_land_use",
        "type": "nominal",
        "title": "Agricultural use"
      },
      {
        "field": "agricultural_share_percentage",
        "type": "quantitative",
        "title": "Share of agricultural area (%)",
        "format": ".2f"
      },
      {
        "field": "area_ha",
        "type": "quantitative",
        "title": "Area (ha)",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}