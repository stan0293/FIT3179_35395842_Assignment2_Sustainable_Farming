{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Do Soil Management Practices Differ Between Industries?",
    "subtitle": "Broadacre and dairy farms reporting practices, three years to 2023–24",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 20
  },
  "width": "container",
  "height": 350,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/soil_management_practices.csv",
    "format": {
      "type": "csv",
      "parse": {
        "adoption_percentage": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "practice",
      "type": "nominal",
      "title": null,
      "sort": [
        "Soil testing",
        "Stubble retention",
        "Cover crops",
        "Incorporated organic matter",
        "Controlled traffic"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelPadding": 12,
        "labelLimit": 150,
        "labelLineHeight": 15,
        "ticks": false,
        "domain": false,
        "labelExpr": "datum.label === 'Soil testing' ? ['Soil', 'testing'] : datum.label === 'Stubble retention' ? ['Stubble', 'retention'] : datum.label === 'Cover crops' ? ['Cover', 'crops'] : datum.label === 'Incorporated organic matter' ? ['Incorporated', 'organic matter'] : ['Controlled', 'traffic']"
      }
    },
    "y": {
      "field": "industry",
      "type": "nominal",
      "title": null,
      "sort": [
        "Wheat and other crops",
        "Mixed livestock and cropping",
        "Dairy",
        "Beef",
        "Sheep",
        "Sheep and beef"
      ],
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 220,
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "adoption_percentage",
          "type": "quantitative",
          "title": "Farms reporting practice (%)",
          "scale": {
            "domain": [0, 100],
            "scheme": "yelloworangebrown"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 250,
            "values": [0, 25, 50, 75, 100],
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "industry",
            "type": "nominal",
            "title": "Farming industry"
          },
          {
            "field": "practice",
            "type": "nominal",
            "title": "Soil management practice"
          },
          {
            "field": "adoption_percentage",
            "type": "quantitative",
            "title": "Farms reporting practice (%)",
            "format": ".0f"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Reporting period"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.adoption_percentage, '.0f') + '%'",
          "as": "percentage_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "percentage_label"
        },
        "color": {
          "condition": {
            "test": "datum.adoption_percentage >= 60",
            "value": "white"
          },
          "value": "black"
        },
        "tooltip": [
          {
            "field": "industry",
            "title": "Farming industry"
          },
          {
            "field": "practice",
            "title": "Soil management practice"
          },
          {
            "field": "adoption_percentage",
            "type": "quantitative",
            "title": "Farms reporting practice (%)",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "subtitleColor": "black"
    }
  }
}