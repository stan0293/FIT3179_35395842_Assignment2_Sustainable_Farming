{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Do Farming Activities Differ in Their Irrigation Profiles?",
    "subtitle": "Australia, 2020–21; each vertical axis has its own scale",
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 20
  },
  "width": "container",
  "height": 360,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 55,
    "right": 35,
    "top": 15,
    "bottom": 15
  },
  "data": {
    "url": "data/irrigation_by_activity.csv",
    "format": {
      "type": "csv",
      "parse": {
        "irrigated_area_ha": "number",
        "application_rate_ml_per_ha": "number",
        "water_applied_gl": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedActivity",
      "value": "Rice",
      "bind": {
        "input": "select",
        "name": "Highlight activity: ",
        "options": [
          "Grazing pastures and cereals",
          "Hay and silage",
          "Vegetables",
          "Fruit and nuts",
          "Grapevines",
          "Nurseries, flowers and turf",
          "Rice",
          "Cereals excluding rice",
          "Cotton",
          "Sugar cane",
          "Other crops"
        ]
      }
    }
  ],
  "transform": [
    {
      "fold": [
        "irrigated_area_ha",
        "application_rate_ml_per_ha",
        "water_applied_gl"
      ],
      "as": ["measure", "actual_value"]
    },
    {
      "calculate": "datum.measure === 'irrigated_area_ha' ? 1 : datum.measure === 'application_rate_ml_per_ha' ? 2 : 3",
      "as": "axis_order"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "actual_value",
          "as": "axis_maximum"
        }
      ],
      "groupby": ["measure"]
    },
    {
      "calculate": "datum.actual_value / datum.axis_maximum",
      "as": "scaled_value"
    }
  ],
  "encoding": {
    "x": {
      "field": "measure",
      "type": "ordinal",
      "sort": [
        "irrigated_area_ha",
        "application_rate_ml_per_ha",
        "water_applied_gl"
      ],
      "scale": {
        "padding": 0.25
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelPadding": 15,
        "labelLimit": 220,
        "labelFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelExpr": "datum.label === 'irrigated_area_ha' ? 'Irrigated area (ha)' : datum.label === 'application_rate_ml_per_ha' ? 'Water per hectare (ML/ha)' : 'Total water applied (GL)'"
      }
    },
    "y": {
      "field": "scaled_value",
      "type": "quantitative",
      "scale": {
        "domain": [0, 1]
      },
      "axis": null
    }
  },
  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "axis_maximum",
              "as": "axis_maximum"
            }
          ],
          "groupby": ["measure"]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#cccccc",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "datum": 0,
          "type": "quantitative"
        },
        "y2": {
          "datum": 1
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "axis_maximum",
              "as": "axis_maximum"
            }
          ],
          "groupby": ["measure"]
        },
        {
          "calculate": "[0, 0.25, 0.5, 0.75, 1]",
          "as": "tick_positions"
        },
        {
          "flatten": ["tick_positions"],
          "as": ["tick_position"]
        },
        {
          "calculate": "datum.measure === 'application_rate_ml_per_ha' ? format(datum.tick_position * datum.axis_maximum, '.1f') : format(datum.tick_position * datum.axis_maximum, ',.0f')",
          "as": "tick_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 11,
        "color": "#555555"
      },
      "encoding": {
        "y": {
          "field": "tick_position",
          "type": "quantitative"
        },
        "text": {
          "field": "tick_label"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#bbbbbb",
        "strokeWidth": 1.5,
        "opacity": 0.45
      },
      "encoding": {
        "detail": {
          "field": "activity",
          "type": "nominal"
        },
        "order": {
          "field": "axis_order",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.activity === selectedActivity"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#2378B5",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "activity",
          "type": "nominal"
        },
        "order": {
          "field": "axis_order",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.activity === selectedActivity"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#2378B5",
        "size": 100
      },
      "encoding": {
        "tooltip": [
          {
            "field": "activity_description",
            "type": "nominal",
            "title": "Activity"
          },
          {
            "field": "irrigated_area_ha",
            "type": "quantitative",
            "title": "Irrigated area (ha)",
            "format": ",.0f"
          },
          {
            "field": "application_rate_ml_per_ha",
            "type": "quantitative",
            "title": "Water applied per hectare (ML/ha)",
            "format": ".2f"
          },
          {
            "field": "water_applied_gl",
            "type": "quantitative",
            "title": "Total water applied (GL)",
            "format": ",.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "title": {
      "color": "black",
      "subtitleColor": "black"
    }
  }
}