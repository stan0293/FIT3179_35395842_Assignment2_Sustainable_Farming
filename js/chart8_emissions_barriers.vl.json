{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Uncertainty Is the Most Reported Barrier Across Farming Industries"],
    "subtitle": [
      "Among the three barriers shown",
      "Percentage of broadacre and dairy farms, Australia, 2023–24"
    ],
    "anchor": "middle",
    "align": "center",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 18,
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "width": "container",
  "height": 300,
  "background": "#ffffff",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/emissions_barriers_by_industry.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percentage_of_farms": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "industry",
      "type": "nominal",
      "title": null,
      "sort": [
        "Dairy",
        "Mixed livestock and cropping",
        "Wheat and other crops",
        "Sheep and beef",
        "Beef",
        "Sheep"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelPadding": 12,
        "labelLimit": 190,
        "labelFontSize": 12,
        "grid": true,
        "gridColor": "#e5e5e5",
        "gridWidth": 1
      },
      "scale": {
        "padding": 0.5
      }
    },
    "x": {
      "field": "percentage_of_farms",
      "type": "quantitative",
      "title": "Farms reporting the barrier (%)",
      "scale": {
        "domain": [0, 100],
        "nice": false,
        "zero": true
      },
      "axis": {
        "values": [0, 20, 40, 60, 80, 100],
        "labelExpr": "datum.value + '%'",
        "grid": false,
        "domain": false,
        "tickSize": 0,
        "labelPadding": 8,
        "titlePadding": 14
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "barrier",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Limited information",
              "Lack of knowledge",
              "Uncertainty"
            ],
            "range": [
              "#8295A3",
              "#B29B7D",
              "#7040A0"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelFontSize": 12,
            "labelLimit": 180,
            "symbolSize": 130,
            "columnPadding": 20,
            "rowPadding": 10,
            "offset": 18
          }
        },
        "shape": {
          "field": "barrier",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Limited information",
              "Lack of knowledge",
              "Uncertainty"
            ],
            "range": [
              "circle",
              "diamond",
              "square"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelFontSize": 12,
            "labelLimit": 180,
            "symbolSize": 130,
            "columnPadding": 20,
            "rowPadding": 10,
            "offset": 18
          }
        },
        "size": {
          "condition": {
            "test": "datum.barrier === 'Uncertainty'",
            "value": 160
          },
          "value": 110
        },
        "tooltip": [
          {
            "field": "industry",
            "type": "nominal",
            "title": "Farming industry"
          },
          {
            "field": "barrier",
            "type": "nominal",
            "title": "Reported barrier"
          },
          {
            "field": "percentage_of_farms",
            "type": "quantitative",
            "title": "Farms reporting the barrier (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.barrier === 'Uncertainty'"
        },
        {
          "calculate": "format(datum.percentage_of_farms, '.0f') + '%'",
          "as": "percentage_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#7040A0"
      },
      "encoding": {
        "text": {
          "field": "percentage_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    }
  }
}