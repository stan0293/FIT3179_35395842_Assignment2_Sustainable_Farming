{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "ABARES NLUM Version 7.1, Australian land use, 2020–21.",
  "width": 740,
  "height": 575,
  "padding": {
    "left": 8,
    "right": 8,
    "top": 12,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "white",
  "title": {
    "text": "How Much of Australia's Land Is Shaped by Farming?",
    "subtitle": ["Explore Australia's agricultural and other land uses in 2020–21"],
    "anchor": "middle",
    "subtitleAnchor": "middle",
    "font": "Lato",
    "fontSize": 28,
    "fontWeight": 900,
    "color": "#000000",
    "subtitleFont": "Lato",
    "subtitleFontSize": 16,
    "subtitlePadding": 10,
    "subtitleColor": "#000000",
    "offset": 32,
    "frame": "bounds",
    "align": "center",
    "lineHeight": 34,
    "subtitleFontWeight": 400,
    "subtitleLineHeight": 20
  },
  "signals": [
    {
      "name": "treemapOffsetY",
      "value": 148
    },
    {
      "name": "legendRowHeight",
      "value": 24
    },
    {
      "name": "agriculturalWidth",
      "update": "width * 419485 / 769614"
    },
    {
      "name": "otherWidth",
      "update": "width - agriculturalWidth"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": "data/chart1_land_use_2020_21.csv",
      "format": {
        "type": "csv",
        "parse": {
          "area_ha": "number",
          "share_total": "number",
          "share_group": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "as": "short_name",
          "expr": "datum.name === 'Grazing native vegetation' ? 'Native grazing' : datum.name === 'Grazing modified pastures' ? 'Modified pastures' : datum.name === 'Managed resource protection' ? 'Resource protection' : datum.name === 'Other minimal use' ? 'Minimal use' : datum.name === 'Production native forests' ? 'Native forests' : datum.name === 'Rural residential and farm infrastructure' ? 'Rural infrastructure' : datum.name === 'Intensive horticulture and animal production' ? 'Intensive production' : datum.name"
        }
      ]
    },
    {
      "name": "tree",
      "source": "raw",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.id === 'root' || datum.parent === 'root' ? 0 : datum.area_ha",
          "as": "layout_weight"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "layout_weight",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height - treemapOffsetY"
            }
          ],
          "paddingTop": 29,
          "paddingInner": 3,
          "paddingOuter": 2,
          "round": true
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        }
      ]
    },
    {
      "name": "insideLabels",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.x1-datum.x0 >= 110 && datum.y1-datum.y0 >= 55"
        }
      ]
    },
    {
      "name": "agricultureLegend",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group === 'Agriculture'"
        },
        {
          "type": "collect",
          "sort": {
            "field": "area_ha",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["legend_index"]
        }
      ]
    },
    {
      "name": "otherLegend",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.group === 'Other land uses'"
        },
        {
          "type": "collect",
          "sort": {
            "field": "area_ha",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["legend_index"]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "tileColors",
      "type": "ordinal",
      "domain": [
        "Grazing native vegetation",
        "Grazing modified pastures",
        "Irrigated pastures",
        "Dryland cropping",
        "Irrigated cropping",
        "Dryland horticulture",
        "Irrigated horticulture",
        "Intensive horticulture and animal production",
        "Nature conservation",
        "Managed resource protection",
        "Other minimal use",
        "Production native forests",
        "Plantation forests",
        "Rural residential and farm infrastructure",
        "Urban residential",
        "Other intensive uses",
        "Mining and waste",
        "Water"
      ],
      "range": [
        "#2675A8",
        "#F2B8D0",
        "#8763BD",
        "#F5B52E",
        "#D99719",
        "#467B63",
        "#9B7345",
        "#6760A8",
        "#138E93",
        "#B56D70",
        "#82912C",
        "#4359A4",
        "#C07E35",
        "#79518A",
        "#5F8293",
        "#A76585",
        "#80654B",
        "#3E9EBD"
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 4
          },
          "y": {
            "value": 15
          },
          "text": {
            "value": "AGRICULTURE"
          },
          "font": {
            "value": "Lato"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#000000"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "agriculturalWidth + 8"
          },
          "y": {
            "value": 15
          },
          "text": {
            "value": "OTHER LAND USES"
          },
          "font": {
            "value": "Lato"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#000000"
          }
        }
      }
    },
    {
      "type": "rect",
      "interactive": false,
      "from": {
        "data": "agricultureLegend"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "4 + ((datum.legend_index - 1) % 2) * (agriculturalWidth / 2)"
          },
          "y": {
            "signal": "33 + floor((datum.legend_index - 1) / 2) * legendRowHeight"
          },
          "width": {
            "value": 12
          },
          "height": {
            "value": 12
          },
          "fill": {
            "scale": "tileColors",
            "field": "name"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "agricultureLegend"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "4 + ((datum.legend_index - 1) % 2) * (agriculturalWidth / 2) + 18"
          },
          "y": {
            "signal": "33 + floor((datum.legend_index - 1) / 2) * legendRowHeight + 6"
          },
          "text": {
            "field": "short_name"
          },
          "font": {
            "value": "Lato"
          },
          "fontSize": {
            "value": 11
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#000000"
          },
          "limit": {
            "signal": "max(0, agriculturalWidth / 2 - 26)"
          }
        }
      }
    },
    {
      "type": "rect",
      "interactive": false,
      "from": {
        "data": "otherLegend"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "agriculturalWidth + 8 + ((datum.legend_index - 1) % 2) * (otherWidth / 2)"
          },
          "y": {
            "signal": "33 + floor((datum.legend_index - 1) / 2) * legendRowHeight"
          },
          "width": {
            "value": 12
          },
          "height": {
            "value": 12
          },
          "fill": {
            "scale": "tileColors",
            "field": "name"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "otherLegend"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "agriculturalWidth + 8 + ((datum.legend_index - 1) % 2) * (otherWidth / 2) + 18"
          },
          "y": {
            "signal": "33 + floor((datum.legend_index - 1) / 2) * legendRowHeight + 6"
          },
          "text": {
            "field": "short_name"
          },
          "font": {
            "value": "Lato"
          },
          "fontSize": {
            "value": 11
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#000000"
          },
          "limit": {
            "signal": "max(0, otherWidth / 2 - 26)"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "signal": "datum.y0 + treemapOffsetY"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "signal": "datum.y1 + treemapOffsetY"
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 3
          }
        }
      }
    },
    {
      "name": "tiles",
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "signal": "datum.y0 + treemapOffsetY"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "signal": "datum.y1 + treemapOffsetY"
          },
          "fill": {
            "scale": "tileColors",
            "field": "name"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Land use': datum.name, 'Group': datum.group, 'Area (ha)': format(datum.area_ha, ',.0f'), 'Share of Australia': format(datum.share_total, '.2f') + '%', 'Share within group': format(datum.share_group, '.2f') + '%'}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#20252B"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "signal": "datum.y0 + treemapOffsetY"
          },
          "x2": {
            "field": "x1"
          },
          "height": {
            "value": 27
          },
          "fill": {
            "signal": "datum.name === 'Agriculture' ? '#274F72' : '#5F6973'"
          },
          "tooltip": {
            "signal": "{'Group': datum.name, 'Area (ha)': format(datum.area_ha, ',.0f'), 'Share of Australia': format(datum.share_total, '.2f') + '%'}"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 9"
          },
          "y": {
            "signal": "datum.y0 + treemapOffsetY + 13"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Lato"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "text": {
            "signal": "datum.name + ' · ' + format(datum.area_ha / 1000000, ',.1f') + 'M ha (' + format(datum.share_total, '.1f') + '%)'"
          },
          "limit": {
            "signal": "max(0, datum.x1 - datum.x0 - 14)"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "insideLabels"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2 + treemapOffsetY"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Lato"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "lineHeight": {
            "value": 18
          },
          "fill": {
            "signal": "indexof(['Grazing modified pastures','Dryland cropping','Irrigated cropping','Other minimal use','Water','Irrigated pastures'], datum.name)>=0 ? '#17222B' : '#FFFFFF'"
          },
          "text": {
            "signal": "[datum.short_name, datum.area_ha >= 1000000 ? format(datum.area_ha / 1000000, ',.1f') + 'M ha' : format(datum.area_ha / 1000, ',.0f') + 'K ha']"
          },
          "limit": {
            "signal": "max(0, datum.x1 - datum.x0 - 12)"
          }
        }
      }
    },
    {
      "name": "agricultureOutline",
      "type": "rect",
      "interactive": false,
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "signal": "datum.y0 + treemapOffsetY"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "signal": "datum.y1 + treemapOffsetY"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#06402B"
          },
          "strokeWidth": {
            "value": 3
          },
          "strokeOpacity": {
            "signal": "datum.name === 'Agriculture' ? 1 : 0"
          }
        }
      }
    }
  ]
}
